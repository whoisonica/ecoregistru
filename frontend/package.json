{
  "name": "ecoregistru-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/serve-config.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint src",
    "test": "node --import ./test/register.mjs --test \"src/**/*.test.ts\"",
    "e2e": "node e2e/run.mjs",
    "start": "serve -s dist -l ${PORT:-4173}"
  },
  "dependencies": {
    "@sentry/react": "^8.55.2",
    "@tanstack/react-query": "^5.51.1",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "serve": "^14.2.3",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.3.3"
  }
}
