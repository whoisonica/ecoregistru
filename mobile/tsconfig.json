{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@web/*": [
        "../frontend/src/lib/*"
      ],
      "@/auth/AuthContext": [
        "./src/auth.ts"
      ],
      "@/lib/*": [
        "../frontend/src/lib/*"
      ],
      "@/components/movements/movementRules": [
        "../frontend/src/components/movements/movementRules.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
