{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@web/*": [
        "../frontend/src/lib/*"
      ],
      "@/auth/AuthContext": [
        "./src/auth.ts"
      ],
      "@/lib/*": [
        "../frontend/src/lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
