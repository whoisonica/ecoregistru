{
  "expo": {
    "name": "WasteHouse",
    "slug": "wastehouse",
    "scheme": "wastehouse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ro.wastehouse.app"
    },
    "android": {
      "package": "ro.wastehouse.app",
      "adaptiveIcon": {
        "backgroundColor": "#161B18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "WasteHouse pozează avizul ca să citească din el predarea. Poza rămâne dovada predării.",
          "photosPermission": "WasteHouse ia din galerie poza unui aviz, ca să citească din ea predarea.",
          "microphonePermission": false
        }
      ],
      "./plugins/mlkit-bundled"
    ],
    "owner": "wastehouses-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14f063d0-b0aa-44f0-898d-49fb1004fe81"
      }
    }
  }
}
